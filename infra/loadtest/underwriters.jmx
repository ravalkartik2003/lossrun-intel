<?xml version="1.0" encoding="UTF-8"?>
<!--
  Brief 12b load test: 25 virtual underwriters for 10 minutes, each cycling through
    open the 1,000-claim account's features → 3 what-ifs (server endpoint) → open 2 documents → save 1 override → ask 1 chat question,
  with 8–14 s of think time between actions; plus one background thread uploading a synthetic loss run every minute.
  Credentials: the Key Vault secret devauth-users (Azure Load Testing secret "devauth"), parsed in a JSR223 pre-processor;
  locally, -Jdevauth="user:password:Role". Never logged. Labels are what the pass/fail criteria in config.yaml name.
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="lossrun 12b — 25 underwriters">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(host)}</stringProp></elementProp>
          <elementProp name="QUOTE" elementType="Argument"><stringProp name="Argument.name">QUOTE</stringProp><stringProp name="Argument.value">${__P(quote,Q-LOAD-1K)}</stringProp></elementProp>
          <elementProp name="DOCS" elementType="Argument"><stringProp name="Argument.name">DOCS</stringProp><stringProp name="Argument.value">${__P(docs,)}</stringProp></elementProp>
          <elementProp name="USERS" elementType="Argument"><stringProp name="Argument.name">USERS</stringProp><stringProp name="Argument.value">${__P(users,25)}</stringProp></elementProp>
          <elementProp name="DURATION" elementType="Argument"><stringProp name="Argument.name">DURATION</stringProp><stringProp name="Argument.value">${__P(duration,600)}</stringProp></elementProp>
          <elementProp name="RAMP" elementType="Argument"><stringProp name="Argument.name">RAMP</stringProp><stringProp name="Argument.value">${__P(ramp,60)}</stringProp></elementProp>
          <elementProp name="DEVAUTH" elementType="Argument"><stringProp name="Argument.name">DEVAUTH</stringProp><stringProp name="Argument.value">${__GetSecret(devauth)}</stringProp></elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="API defaults">
        <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
        <stringProp name="HTTPSampler.protocol">https</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">90000</stringProp>
        <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Auth and JSON">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">${AUTH}</stringProp></elementProp>
          <elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Basic auth from devauth-users (once per thread)">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">if (vars.get("AUTH") == null) {
  def raw = vars.get("DEVAUTH")
  if (raw == null || raw.isEmpty() || raw.startsWith('${')) raw = props.getProperty("devauth", "")
  def entry = raw.split(";").collect { it.trim() }.find { it.startsWith("underwriter:") }
  if (entry == null) throw new IllegalStateException("no underwriter entry in devauth")
  def parts = entry.split(":")
  vars.put("AUTH", "Basic " + (parts[0] + ":" + parts[1]).bytes.encodeBase64().toString())
  def docs = vars.get("DOCS").split(",").findAll { !it.isEmpty() }
  vars.put("DOC_COUNT", String.valueOf(docs.size()))
}</stringProp>
      </JSR223PreProcessor>
      <hashTree/>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Underwriters">
        <stringProp name="ThreadGroup.num_threads">${USERS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__jexl3(${DURATION} + ${RAMP})}</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="features">
          <stringProp name="HTTPSampler.path">/api/v1/quotes/${QUOTE}/features?view=adjusted</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="think">
            <stringProp name="ConstantTimer.delay">8000</stringProp>
            <stringProp name="RandomTimer.range">6000</stringProp>
          </UniformRandomTimer>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="label hit or miss">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def h = prev.getResponseHeaders() =~ /(?i)X-Feature-Snapshot:\s*(\w+)/
prev.setSampleLabel(h.find() ? "features-" + h.group(1) : "features-unknown")</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>

        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="3 what-ifs">
          <stringProp name="LoopController.loops">3</stringProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="what-if">
            <stringProp name="HTTPSampler.path">/api/v1/quotes/${QUOTE}/features/what-if</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${WHATIF}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="what-if scenario">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def r = new Random()
def cap = [null, 25000000, 50000000][r.nextInt(3)]
vars.put("WHATIF", groovy.json.JsonOutput.toJson([view: "adjusted", scenario: [reserveFactorBps: r.nextInt(5001) - 2000, includeCT: r.nextBoolean(), capPerClaimCents: cap].findAll { it.value != null }]))</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="json">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="think">
              <stringProp name="ConstantTimer.delay">8000</stringProp>
              <stringProp name="RandomTimer.range">6000</stringProp>
            </UniformRandomTimer>
            <hashTree/>
          </hashTree>
        </hashTree>

        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="2 documents">
          <stringProp name="LoopController.loops">2</stringProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="document">
            <stringProp name="HTTPSampler.path">/api/v1/documents/${DOC}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="pick a document">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def d = vars.get("DOCS").tokenize(",")
vars.put("DOC", d[new Random().nextInt(d.size())])</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="think">
              <stringProp name="ConstantTimer.delay">8000</stringProp>
              <stringProp name="RandomTimer.range">6000</stringProp>
            </UniformRandomTimer>
            <hashTree/>
          </hashTree>
        </hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="override">
          <stringProp name="HTTPSampler.path">/api/v1/documents/${OVR_DOC}/overrides</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"overrides":[{"fieldPath":"policyPeriods[0].claims[0].medical.reserve","newValue":${OVR_VALUE},"rationale":"load test: reserve per adjuster note"}],"rationale":"brief 12b load test"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="this thread's document">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def d = vars.get("DOCS").tokenize(",")
vars.put("OVR_DOC", d[(ctx.getThreadNum() + vars.getIteration()) % d.size()])
vars.put("OVR_VALUE", String.valueOf(100 + new Random().nextInt(99900)))</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="json">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="think">
            <stringProp name="ConstantTimer.delay">8000</stringProp>
            <stringProp name="RandomTimer.range">6000</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="chat">
          <stringProp name="HTTPSampler.path">/api/v1/chat/turns</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${CHAT}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="chat question">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def q = ["How many claims are open?", "What is the total incurred across all claims?", "Which claim has the largest total incurred?",
         "How many claims have total incurred of 25,000 dollars or more?", "What is the total paid to date?"]
vars.put("CHAT", groovy.json.JsonOutput.toJson([scope: "quote", quoteId: vars.get("QUOTE"), question: q[new Random().nextInt(q.size())]]))</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="json">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="think">
            <stringProp name="ConstantTimer.delay">8000</stringProp>
            <stringProp name="RandomTimer.range">6000</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>
      </hashTree>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Background simulator">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__jexl3(${DURATION} + ${RAMP})}</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="upload">
          <stringProp name="HTTPSampler.path">/api/v1/uploads</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">true</boolProp>
          <elementProp name="HTTPsampler.Files" elementType="HTTPFileArgs">
            <collectionProp name="HTTPFileArgs.files">
              <elementProp name="lossrun-export.csv" elementType="HTTPFileArg">
                <stringProp name="File.path">lossrun-export.csv</stringProp>
                <stringProp name="File.paramname">file</stringProp>
                <stringProp name="File.mimetype">text/csv</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="quoteId" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">quoteId</stringProp>
                <stringProp name="Argument.value">Q-LOAD-BG</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="idempotency">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header"><stringProp name="Header.name">Idempotency-Key</stringProp><stringProp name="Header.value">load-${__UUID()}</stringProp></elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="1 per minute">
            <stringProp name="ConstantTimer.delay">60000</stringProp>
          </ConstantTimer>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
