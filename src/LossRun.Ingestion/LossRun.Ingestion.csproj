<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LossRun.Ingestion</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.ContentUnderstanding" Version="1.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- PDFsharp pinned: 6.2.x is MIT; 6.5.0 is AGPL-3.0-only. Used only to write a decrypted copy of a PDF unlocked by PdfPig. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- Overrides PDFsharp/ExcelDataReader's transitive 8.0.1, which has known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LossRun.Contracts\LossRun.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CU analyzer definitions (checked in, versioned by analyzer id) and the price table (repo config/). -->
    <EmbeddedResource Include="Analyzers\*.json" LogicalName="LossRun.Analyzers.%(Filename).json" />
    <EmbeddedResource Include="..\..\config\azure-prices.json" LogicalName="LossRun.Config.azure-prices.json" Link="Config\azure-prices.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LossRun.Ingestion.Tests" />
  </ItemGroup>
</Project>
