<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- PdfPig is used directly to verify decrypted output. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LossRun.Ingestion\LossRun.Ingestion.csproj" />
    <ProjectReference Include="..\LossRun.Contracts\LossRun.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestShared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <None Include="..\TestShared\fixtures\*" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Recorded\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
