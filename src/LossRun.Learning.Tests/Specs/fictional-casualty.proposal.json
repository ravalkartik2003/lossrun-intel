{
  "carrierName": "Fictional Casualty Group",
  "description": "Fictional Casualty Group portrait loss history: policy summary box, one claim table per policy under a 'Policy No: … Eff … Exp …' heading, Policy Total and Account Total rows with the claim count only.",
  "tableLocator": {
    "sheet": null,
    "headerMatchMin": 0.8,
    "blockAnchor": "^Policy No:\\s*(?<policyNumber>\\S+)\\s+Eff\\s+(?<effectiveDate>\\d{2}/\\d{2}/\\d{4})\\s+Exp\\s+(?<expirationDate>\\d{2}/\\d{2}/\\d{4})\\s*$",
    "rowKinds": [
      { "kind": "subtotal", "regex": "^Policy Total\\b", "countsRegex": "(?<claimCount>\\d+)\\s+Claims?\\b" },
      { "kind": "grandTotal", "regex": "^Account Total\\b", "countsRegex": "(?<claimCount>\\d+)\\s+Claims?\\b" }
    ],
    "lineFallback": { "enabled": true, "deskew": true, "lineTolerance": 0.5, "minHeaderMatch": 0.7, "assignment": "headerLeftEdge" }
  },
  "columnMap": [
    { "source": "Claim No", "target": "claim.claimNumber", "normalizer": { "type": "claimNumber", "glossaryField": null, "pattern": null, "format": null, "codeSystem": null }, "nullWhen": null },
    { "source": "Employee", "target": "claim.claimantName", "normalizer": { "type": "text" } },
    { "source": "Accident Dt", "target": "claim.dateOfInjury", "normalizer": { "type": "date" } },
    { "source": "Rptd", "target": "claim.dateReported", "normalizer": { "type": "date" } },
    { "source": "Cls Dt", "target": "claim.dateClosed", "normalizer": { "type": "date" }, "nullWhen": [""] },
    { "source": "St", "target": "claim.status", "normalizer": { "type": "enum", "glossaryField": "claim.status" } },
    { "source": "St", "target": "claim.rawStatus", "normalizer": { "type": "text" } },
    { "source": "Ind. Pd", "target": "claim.indemnity.paid", "normalizer": { "type": "currency" } },
    { "source": "Ind. Res", "target": "claim.indemnity.reserve", "normalizer": { "type": "currency" } },
    { "source": "Med. Pd", "target": "claim.medical.paid", "normalizer": { "type": "currency" } },
    { "source": "Med. Res", "target": "claim.medical.reserve", "normalizer": { "type": "currency" } },
    { "source": "Exp. Pd", "target": "claim.expense.paid", "normalizer": { "type": "currency" } },
    { "source": "O/S", "target": "claim.total.reserve", "normalizer": { "type": "currency" } },
    { "source": "Tot. Inc", "target": "claim.total.incurred", "normalizer": { "type": "currency" } }
  ],
  "ignoredHeaders": [],
  "periods": { "source": "blockAnchor", "column": null, "lookup": null },
  "documentFields": [
    { "target": "document.carrierName", "locator": { "type": "paragraphRole", "role": "title" }, "normalizer": { "type": "text" }, "reason": null },
    { "target": "document.insuredName", "locator": { "type": "regex", "pattern": "Named Insured:\\s*(?<value>.+?)(?=\\s+Evaluation Date:|\\s*$)" }, "normalizer": { "type": "text" } },
    { "target": "document.valuationDate", "locator": { "type": "regex", "pattern": "Evaluation Date:\\s*(?<value>\\d{2}/\\d{2}/\\d{4})" }, "normalizer": { "type": "date" } },
    { "target": "document.reportRunDate", "locator": { "type": "regex", "pattern": "Printed:\\s*(?<value>\\d{2}/\\d{2}/\\d{4})" }, "normalizer": { "type": "date" } },
    { "target": "document.lineOfBusiness", "locator": { "type": "regex", "pattern": "(?<value>Workers Compensation)" }, "normalizer": { "type": "enum", "glossaryField": "document.lineOfBusiness" } },
    { "target": "document.noLossesStatement", "locator": { "type": "regexPresent", "pattern": "(?i)no losses (were )?reported" } },
    { "target": "document.expenseTreatment", "locator": { "type": "const", "value": "separate" }, "reason": "Expense paid has its own column (Exp. Pd); no expense reserve column is printed." }
  ],
  "derivedRules": [
    { "target": "indemnity.incurred", "sum": ["indemnity.paid", "indemnity.reserve"], "when": "absent", "appliesTo": ["claim", "totals"] },
    { "target": "medical.incurred", "sum": ["medical.paid", "medical.reserve"], "when": "absent", "appliesTo": ["claim", "totals"] }
  ],
  "periodBoundaries": { "expirationInclusive": false },
  "validation": { "expectedApplicable": ["R-01", "R-02", "R-06", "R-07", "R-08", "R-09", "R-10", "R-11", "R-12", "R-13", "R-16", "R-21", "R-26"], "softOverrides": [] }
}
