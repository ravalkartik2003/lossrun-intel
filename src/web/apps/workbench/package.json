{
  "name": "@lossrun/workbench",
  "version": "1.0.0",
  "description": "Loss Run Intelligence workbench (brief 11): seven screens over the LossRun API, with a mock mode.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@azure/msal-browser": "5.26.0",
    "@fontsource/public-sans": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@lossrun/metrics": "1.0.0",
    "@lossrun/ui": "1.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "echarts": "6.1.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "msw": "2.15.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "msw": { "workerDirectory": ["public"] }
}
