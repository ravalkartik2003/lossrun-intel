{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@docs/*": ["../../../../docs/*"],
      "@mock/*": ["../../../../docs/ui/mock/*"]
    }
  },
  "include": ["src", "e2e", "../../packages/ui/src", "../../packages/metrics/src", "../../packages/metrics/test/perf-account.ts"]
}
