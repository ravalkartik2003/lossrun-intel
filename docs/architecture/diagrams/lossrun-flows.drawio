l=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="SSE end · GET /uploads/{id}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;If a rule sends it to review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;document-review item · upload awaiting-review · quote.payload withheld until decided&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;reviewer: accept / save changes and approve / reject · overrides → revision+1, re-validate, lineage manual&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;then the same downstream chain at the new quote revision; a stale revision at the receiver gets 409 and is marked superseded&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#C9D1DA;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1900" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>