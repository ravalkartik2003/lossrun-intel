l><mxCell id="c49" value="Review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c38" target="c41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="400"/><mxPoint x="620" y="400"/><mxPoint x="620" y="665"/></Array></mxGeometry></mxCell><mxCell id="c50" value="clean" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F7A4D;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c40" target="c39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="562"/><mxPoint x="985" y="452"/></Array></mxGeometry></mxCell><mxCell id="c51" value="&lt;b&gt;LearnGate (Durable entity)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;slots = Learn__MaxConcurrent (Terraform 1, code default 3)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;lease 15 min · denied → durable timer 10 s · if it waited: Route again&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;(a document queued behind its own carrier replays the format learned meanwhile)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="320" height="84" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Prompt (learn-v11, byte-identical prefix)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;glossary fields + composite/conditional words + ignore list · rule catalog · strict JSON schema&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;document: first 3 pages markdown ≤12k chars, header cells with (glossary: field), 8 sample rows&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;INSTRUCTION lines from LayoutEvidenceDetector: records-rows/lines, measures-as-rows,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;stacked, claims-with-period-totals · header-block fields (ADR 0023) · prior spec on drift&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="210" width="320" height="100" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Model call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;gpt-5.4-mini@2026-03-17 (config/models.json; gpt-5.2 when quota)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Responses API, strict json_schema, prompt cache key lossrun-learn-v11&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;429 retry ≤8 honouring retry-after · metered: in/cached/out tokens&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="340" width="320" height="84" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Lint autofixes (no model) — SpecLint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;LocatePrintedConstants · RetargetRowLevelColumns · RetargetCodedColumns · MapLookupSubtotals&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;RelaxRowKindPunctuation · UnanchorTotalRowKinds · LocateLabelNextDates · MapPeriodDateColumns&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;FitNormalizers · KeepPrintedZeros · DropUnnamedComponents · FixPunctuationBoundaries&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;RepairStackedParts · RepairMeasureColumns · DeclareAbsentComponents · DeclareStatusFrom · LocateHeaderFields&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;+ lint CHECKS → issues (mapped-and-ignored, two columns→one target, const outside allow-list…)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="450" width="320" height="110" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Verifier = replay this spec on this document&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;hard failures · unmapped headers · issues · required fields (learn-gate.json 0.3.0)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;totals tie: R-10/R-12 (summary-only: R-26, every amount checked)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;document facts: 'prints no valuation date', 'losses window ≠ policy period'&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="590" width="320" height="84" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Gate passes?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;0 hard · 0 unmapped · 0 issues · claimNumber present · and&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;pdf-totals / spreadsheet-totals: nothing missing &amp; tie == true&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;spreadsheet-rules: spreadsheets only, coverage ≥ 0.8, carrier from submission&lt;/font&gt;" style="rhombus;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="700" width="320" height="110" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Attempt ≤ 5?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;maxIterations pdf 5 / spreadsheet 5&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;(env LOSSRUN_LEARN_MAX_ITERATIONS)&lt;/font&gt;" style="rhombus;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="840" width="320" height="80" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Learn exhausted&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;best attempt by penalty → best-attempt.replay.json (reviewer pre-fill)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;finalTier Review · document-review item&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;escalation learn-exhausted / delta-exhausted (ADR 0025)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE9D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="