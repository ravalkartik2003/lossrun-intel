target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="no → feedback turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c56" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c67" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F7A4D;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c57" target="c52"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="880"/><mxPoint x="1370" y="260"/></Array></mxGeometry></mxCell><mxCell id="c68" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c57" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="&lt;b&gt;Publish spec (immutable version)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;formatId = slug-pdf|xlsx|csv · version = max+1 · createdBy learn:model@ver&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;fingerprint keys + embedding centroid (1 embedding, running average)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;learning record: model, prompt version, iterations, tokens, verificationGate&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;status: SHADOW for a new carrier; delta/relearn inherits prior status&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1400" y="700" width="340" height="96" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;Registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;dbo.Format · dbo.FormatVersion (SpecJson)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;dbo.FormatFieldStats · Blob formats/{id}/{v}.json&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;index.json · stats.json · centroid.json&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1E5AA8;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1400" y="830" width="340" height="70" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;Confirm-format review (human)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;learning document + every replay of a shadow format opens one&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;'Confirm format and approve document' → active (approval:user)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;'Approve document only' → stays shadow · reject never activates&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE9D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1400" y="930" width="340" height="84" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b&gt;Active&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;also automatic after 3 clean ReplayAccepted&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;(a Review or hard failure resets the count)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;retired versions excluded from matching, kept for lineage&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1400" y="1040" width="340" height="70" as="geometry"/></mxCell><mxCell id="c73" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F7A4D;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c56" target="c69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c69" target="c70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c70" target="c71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c71" target="c72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c77" value="&lt;b&gt;Glossary alias lifecycle (ADR 0019)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;① CANDIDATE — at publish, every column mapping the seed glossary does not already resolve to that field&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;   (confidence 0.9, provenance: format, document, model, prompt version, totals tie)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;② EVIDENCE — every ReplayAccepted that uses the alias adds a document + format&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;③ ACTIVE — automatic at ≥3 documents across ≥2 formats (code default AliasPolicy; brief 21 asked 5/3 as config — not yet)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;   or reviewer accept / re-map in the confirm-format review (implied accept for untouched candidates)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;④ RESOLVES — only ACTIVE aliases resolve headers, after the seed, for every carrier&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;⑤ RETIRED — reviewer reject, or a correction on a value read through it (audit-linked); never re-learned&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Hand base glossary.json (0.4.3): changed only by pull request; it is in the prompt prefix → corpus v5 prompt gate&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#C9D1DA;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="340" height="230" as="geometry"/></mxCell><mxCell id="c78" value="candidate aliases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c69" target="c77"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1760" y="729"/><mxPoint x="1760" y="330"/></Array></mxGeometry></mxCell><mxCell id="c79" value="alias evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c77"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="452"/><mxPoint x="1000" y="238"/></Array></mxGeometry></mxCell><mxCell id="c80" value="&lt;b&gt;Rules that decide where a header mapping lives&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Meaning of a word (true for any carrier) → glossary (global). Where/how this layout prints it → format spec (per fingerprint).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;A header the glossary does not know starts INSIDE the spec as a candidate; it becomes global only with evidence across formats or a reviewer's confirmation.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;A header whose meaning depends on the table ('Loss' needs a medical sibling) is a conditional alias: global, with the condition attached.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Replay never proposes anything; learn never publishes without the verifier; a human confirms every new format before it is active (or 3 clean replays do).&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#C9D1DA;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="580" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2-Durable-orchestration-and-multi-file-sync" name="2 Durable orchestration and multi-file sync"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1600" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="2 · Durable Functions + Durable Task Scheduler: one upload with several files, from POST to the quote system" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#15233B;fontSize=16;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2000" height="28" as="geometry"/></mxCell><mxCell id="c4" value="Swimlanes = where the step runs. Orchestrator code is deterministic and replayed from DTS history; every activity is idempotent. Names are the real function/activity/table names." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="2000" height="36" as="geometry"/></mxCell><mxCell id="c5" value="Browser" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=11;align=left;ve