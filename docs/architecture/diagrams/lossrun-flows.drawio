;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;format approve if promote &amp; not reject&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2800" y="385.0" width="190" height="76" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;EXEC dbo.ApplyDecision (one round trip)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;UPDLOCK on Document · revision check → 0/1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Override · AuditEvent · Claim history · RuleOutcome&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;ReviewItem decided · Outbox review.decided + quote.revised&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;+ quote.payload if last review · BumpQuoteRevision&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1E5AA8;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2800" y="895.0" width="190" height="96" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;QuoteCommandDispatch (sessions)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;PUT quotes/{q} · 2xx delivered/replayed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;409 stale-revision → superseded (no retry)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;other 4xx → DLQ · 5xx → redeliver ≤10&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#5B4BB5;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="2800" y="1031.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Quote system&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Event Grid quote.revised → fetch&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;payload?revision=n · page SSE update&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#5B4BB5;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="3015" y="1035.0" width="190" height="76" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;completed | reviews-expired (7 d → ExpireReviews)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="3015" y="385.0" width="190" height="76" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="Learn / Delta tier" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="replay tier" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1495" y="590"/><mxPoint x="1495" y="602"/><mxPoint x="1920" y="602"/></Array></mxGeometry></mxCell><mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c32" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c67" value="external event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c37" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" value="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c35" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="pending empty" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c38" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="timer wins" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2465" y="478"/><mxPoint x="2995" y="478"/></Array></mxGeometry></mxCell><mxCell id="c74" value="&lt;b&gt;Synchronisation rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Upload status is a stored manifest field; concurrent activities of one upload serialise on dbo.Upload (UPDLOCK, HOLDLOCK).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• A retried activity is harmless: PersistExtraction returns early if the document exists; RecordItems upserts; OpenReview inserts only if absent; blobs are rewritten identically.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• No Durable retry policies on activities: an activity failure → FailUpload (status failed + unhandled-exception escalation) → orchestration Failed. Retries live lower: model client 8×, EF execution strategy.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Decisions: dbo.ApplyDecision locks the document row and refuses a stale revision; direct overrides retry ≤5 with jitter; a second decision on the same item → 409 not-pending.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Idempotency: uploadId from Idempotency-Key or content hash; documentId = sha256(uploadId:fileSha) — so re-POSTing the same package never creates a second upload.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• document-review holds the upload status and the first quote.payload; confirm-format keeps the instance open but neither the status nor the push.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• DTS: Consumption SKU, task hub 'lossrun', Flex Consumption FC1 (2 GB, max 40 instances), always-ready ×1 only in demo mode; functionTimeout 30 min; host.json storageProvider azureManaged.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#C9D1DA;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="2100" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3-Validation-engine" name="3 Validation engine"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1600" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="3 · Validation engine: every rule, where it runs, what it causes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#15233B;fontSize=16;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2000" height="28" as="geometry"/></mxCell><mxCell id="c4" value="Catalog is data (rule-catalog.json 0.11.0, embedded); the evaluator is generic, pure and deterministic. Three-valued logic: a null operand → not applicable, never a failure. Severity: hard blocks straight-through · soft warns · flag routes." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="2000" height="36" as="geometry"/></mxCell><mxCell id="c5" value="Deterministic step (code, no model)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="90" width="230" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Model call (metered)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="120" width="230" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Decision" style="rhombus;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="150" width="230" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Store (SQL · Blob · index)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1E5AA8;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="180" width="230" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Human step" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE9D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="210" width="230" height="24" as="geometry"/></mxCell><mxCell id="c10" value="Published / straight-through" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="240" width="230" height="24" as="geometry"/></mxCell><mxCell id="c11" value="External system" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#5B4BB5;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1760" y="270" width="230" height="24" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;(a) Ingestion checks — no rules, no model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Classifier segment decision: no table → review · conf ≥0.8 accept · ≥0.5 review · else not a loss run&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• MergeContinuations (same header, no header block, same carrier) · &gt; 3 segments → escalation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Line of business ≠ WC → kept, not processed (ADR 0020) · loss-analysis / changes-only → kept (ADR 0021)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Output: graph.json + manifest items (processing / kept-not-processed + reason / unsupported)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="760" height="86" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;(b) Learn gate — before a spec may publish&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Replay the candidate on its own document → full catalog&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Refuse if: any hard failure · any unmapped header · any lint issue · claim.claimNumber missing&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Refuse if ambiguous composite and totals do not tie&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• pdf-totals / spreadsheet-totals: nothing missing (learn-gate.json required fields) and tie == true&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• spreadsheet-rules: spreadsheets only, coverage ≥ 0.8, carrier from submission&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• summary-only: R-26 ties and EVERY printed amount is covered by a check&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="760" height="116" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;(c) Validation on every document — replay hits included&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• ReplayEngine.Execute → RuleEvaluator (R-01…R-32) · stored in ResultJson and dbo.RuleOutcome per revision&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• FormatRouter.Decide consumes hard/soft/flag counts → tier (see chain)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• ValidateAndPersist re-runs the evaluator on the stored replay&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• UI: RulesDock 'N failing of M', failingPaths outlined, click-to-source via affectedFields&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="760" height="86" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;(d) After an override — re-derive and re-validate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Only an 'override' decision may carry overrides (else 400)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Value set · lineage → manual (rationale, confidence 1.0) · derived sums recomputed when a source changed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Catalog re-evaluated → revision+1 RuleOutcome rows via dbo.ApplyDecision&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="760" height="71" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;(e) Field status and quote readiness (derived, never stored)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Per field: reject → rejected · pending/reopened → unresolved · R-33 required &amp; null → unresolved(R-33)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• manual override → approved (wins over a still-failing rule) · hard failure touching the path → unresolved(ruleId) · else approved&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Readiness: ready iff ≥1 counted document, none pending, 0 unresolved; rejected documents excluded and never block&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• verified-only view: non-approved values → null in quote payload and memo; Loss Information cell 'needs input'&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="531" width="760" height="86" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;(f) Escalation sweep — patterns, hourly&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• immediate: learn-exhausted · delta-exhausted · replay-failed-active-format · cost &gt; $0.15 · too-many-segments · unhandled-exception · manual flag&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• hourly: same fingerprint reviewed ≥3 in 7 d · one rule on ≥80 % of a carrier's docs (min 5) · review-rate +20 pts vs 30 d · reopened &gt;2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• dedupe (reason, fingerprint) → dbo.Escalation → Needs-investigation screen · Event Grid · alert rule&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="760" height="71" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Per-claim amounts — hard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-01 paid ≤ incurred (±$1) per component&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-02 incurred = paid + reserve (not-informative when derived)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-03 no negative amounts&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-05 medical-only → indemnity = 0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-20 total = ind+med+exp (soft; hard when expense printed separately)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-29 total = ind+med when header declares it (soft/hard)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="420" height="108" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Dates — hard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-06 DOI ≤ valuation date&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-07 DOI ≤ reported (soft for cumulative trauma / CT codes 02,03)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-08 DOI within policy period (soft for CT)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-21 reported ≤ valuation · closed ≤ valuation · closed ≥ DOI&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="840" y="220" width="420" height="80" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Identity — hard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-09 unique claim numbers (normalised)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-19 claim number present when incurred &gt; $2,000&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="840" y="312" width="420" height="52" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Ties to printed totals — hard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-10 period subtotals = Σ rows (or + kept rows) — also the learn-gate tie&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-11 period counts tie (claims, open, closed)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-12 grand totals = Σ all rows (n/a if any period summary-only)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-13 grand counts tie&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-26 Σ period subtotals = grand total (summary-only gate rule)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="840" y="376" width="420" height="94" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Periods — hard/flag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-14 'no losses' period → 0 rows (per period, ADR 0016)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-27 flag: empty period with no statement and no totals&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-28 flag: 'no losses' statement tied to no period&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="840" y="482" width="420" height="66" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Soft warnings — soft&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-04 closed → reserve 0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-16 reopened → some reserve &gt; 0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-22 net &lt; gross needs a subrogation recovery&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-15 valuation within 100 days of target effective (needs context — n/a in pipeline today)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-25 requested policy years present (needs context — n/a today)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#C9D1DA;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="840" y="560" width="420" height="94" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Routing / analytics flags — flag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-17 jurisdiction CA · R-18 line of business WC&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-23 report lag ≤ 30 d (emits lagDays) · R-24 large loss ≥ $100k&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-30 status printed or verified (unknown → flag)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-31 kept rows but no printed total to reconcile&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-32 valuation date came from the submission, not the page&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#C9D1DA;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="840" y="666" width="420" height="94" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Quote level (never routes a document) — hard → readiness&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-33 required for quoting: carrier, valuation date, period dates (unless summary-only with label), claim number, DOI, status, total incurred&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• → field status unresolved(R-33) → readiness block → null in payload&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="840" y="772" width="420" height="52" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Routing chain (FormatRouter.Decide, first match wins)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;1 carrier mismatch → Review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;2 no format &amp; narrative PDF (0 tables) → Review, not learned&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;3 no format → Learn (after recovery replay failed)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;4 drift &amp; unmapped&gt;0 &amp; soft≤3 → ReplayWithDelta&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;5 drift → Learn (prior = matched spec)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;7 no replay → Review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;8 0 claim rows, no 'no losses', no summary-only period → Review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;9 hard&gt;0 and all failures OCR-level (scans) → Review with pre-fill&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;10 hard=0, unmapped=0, soft=0 → ReplayAccepted&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;11 hard=0, unmapped=0, soft≤3 → ReplayAccepted + warnings&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;12 unmapped&gt;0, soft≤3 → ReplayWithDelta&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;13 else → Review (hard with all mapped, or soft&gt;3)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;post: Accepted but format prints totals and none read → Review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;post: ambiguous composite without a clean R-10/R-12 pass → Review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;post: Learn on a scan &lt; 280 dpi → Review (not learned)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#C9D1DA;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="100" width="440" height="260" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Final tier and what the user sees&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;ReplayAccepted → processed, no review item, 0 LLM calls badge&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Learned (published) → processed + confirm-format item (shadow)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Delta (published) → processed, version n+1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Review → awaiting-review item (document-review), upload awaiting-review,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;   quote.payload withheld until the last document-review is decided&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;kept-not-processed is decided only at stage (a), never by a rule&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#C9D1DA;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="380" width="440" height="120" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Known gaps found while verifying&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-15 and R-25 need a RuleContext that no production path supplies → always n/a&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-23's lagDays is emitted but only the eval CLI reads it&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• R-31's condition is re-coded for the manifest reason (agrees today)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;• Routing/gate checks without an R-id: empty replay, totals printed but none read, ambiguous composite, narrative, carrier mismatch, low dpi, OCR-level classification, unmapped headers, lint, coverage&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#C9D1DA;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="520" width="440" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4-End-to-end---new-carrier-format" name="4 End to end - new carrier format"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1600" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="4 · End to end, case A: a carrier format never seen before — fingerprint miss → learn → shadow → confirm-format → active → quote system" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#15233B;fontSize=16;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2000" height="28" as="geometry"/></mxCell><mxCell id="c4" value="Model calls: 1 embedding (fingerprint) + 1–5 learn calls + 1 embedding (centroid) + chat-index embeddings. A human confirms the format once; until then the quote payload excludes the document as pending-review." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="2000" height="36" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Upload screen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;POST /uploads (files, quoteId, carrierHint, valuationDate)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Idempotency-Key ui-&lt;uuid&gt; · then SSE /events&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="230" height="84" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;CreateUpload → 202&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;uploadId up-… · Blob uploads/{id}/{file}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;dbo.Upload received · AuditEvent upload.create&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;start IngestUploadOrchestrator (instance = uploadId)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="285" y="206" width="230" height="84" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ExpandUpload → ParseFile ×N → RecordItems&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;→ ProcessLossRun ×M → CompleteUpload&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;SSE progress: expand · parse · fingerprint · route · replay|learn · validate · done&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="530" y="312" width="230" height="84" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Ingestion (CU, metered)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;layout (single run) or classifier (bundle split) → graph.json&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;header repair · stacked headers · evidence detector · header-block fields&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;LOB ≠ WC / analysis / changes-only → kept, not processed · UsageEvent per page&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="775" y="418" width="230" height="84" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Fingerprint MISS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;identity+header keys: no match · no drift&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;embedding tier: 1 embedding, cosine &lt; threshold or containment &lt; 0.8&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;recovery replay of same-kind formats: no usable candidate&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;→ tier Learn · routing.json&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="524" width="230" height="84" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Learn (1–5 model calls, gpt-5.4-mini)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;LearnGate slot (Terraform 1) → prompt with evidence → strict JSON spec&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;lint autofixes → verifier (replay + catalog + gate) → feedback loop&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;measured: p50 40 s, p95 92 s, mean $0.051/document&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1265" y="630" width="230" height="96" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Publish v1 as SHADOW&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;formatId slug-pdf · centroid embedding · learning record&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;candidate glossary aliases for unknown headers&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Outbox format.learned · dbo.Format/FormatVersion&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1265" y="748" width="230" height="84" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ValidateAndPersist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;catalog on the published replay · finalTier Learned&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;reviewKind confirm-format (shadow) · ReviewState pending&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;SQL txn: Document, PolicyPeriod, Claim, ExtractedValue (lineage per field),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;RuleOutcome, DocumentCost, AuditEvent extraction.persist · chat index queued&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1E5AA8;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1510" y="854" width="230" height="96" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;CompleteUpload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;awaiting = 0 (confirm-format does not hold) → status completed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;BumpQuoteRevision → 1 · Outbox upload.completed, quote.revised, quote.payload&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;payload at rev 1: document in excluded[] as pending-review — NO claims yet&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="530" y="972" width="230" height="96" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Confirm-format review (human)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;alias review (candidate → accept / edit / reject)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;'Confirm format and approve document' → promoteToFormat&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;'Approve document only' keeps it shadow · reject never activates&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE9D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="230" height="96" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;ApplyDecision&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;revision 2 · re-validate · FormatLifecycle.Approve → ACTIVE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;EXEC dbo.ApplyDecision: Override/AuditEvent review.accept + format.approve,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;ReviewItem decided, Outbox review.decided + quote.revised + quote.payload, BumpQuoteRevision → 2&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1E5AA8;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="530" y="1208" width="230" height="96" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;OutboxRelay → Service Bus / Event Grid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;fast path + 30 s sweep · MessageId = event id = Idempotency-Key = outbox id&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;session = quoteId · duplicate detection 1 day · DLQ after 10&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#5B4BB5;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1755" y="1326" width="230" height="84" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;QuoteCommandDispatch → PUT quotes/{q}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Idempotency-Key header · 2xx delivered · 409 stale-revision → superseded&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;other 4xx → DLQ · 5xx → redeliver&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#5B4BB5;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1755" y="1432" width="230" height="84" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Quote system (mock)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;stores lossRunAnalysis by highest revision · fetches&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;GET /quotes/{q}/quote-payload?revision=n (ETag q-n, 304, 409 superseded)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Event Grid lossrun.quote.revised also triggers the fetch · page SSE 'revision'&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#5B4BB5;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1755" y="1538" width="230" height="96" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Loss Information page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;one column per policy period · approved values fill · unresolved 'needs input'&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;rejected document → 'excluded' · premium/payroll/ex-mod blank (not from loss run)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;live check: revision 2 visible 1 s after the decision&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1755" y="1656" width="230" height="84" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Chat index (AI Search lossrun-docs)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;one chunk per page/sheet, original page text only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;embeddings metered to the upload · never overwritten by corrections&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1755" y="1762" width="230" height="84" as="geometry"/></mxCell><mxCell id="c21" value="Browser / UI" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=9;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="230" height="18" as="geometry"/></mxCell><mxCell id="c22" value="HTTP API" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=9;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="285" y="80" width="230" height="18" as="geometry"/></mxCell><mxCell id="c23" value="Orchestration" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=9;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="80" width="230" height="18" as="geometry"/></mxCell><mxCell id="c24" value="Ingestion" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=9;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="775" y="80" width="230" height="18" as="geometry"/></mxCell><mxCell id="c25" value="Format memory" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=9;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="230" height="18" as="geometry"/></mxCell><mxCell id="c26" value="Learn" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=9;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1265" y="80" width="230" height="18" as="geometry"/></mxCell><mxCell id="c27" value="Validate &amp; persist" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=9;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="80" width="230" height="18" as="geometry"/></mxCell><mxCell id="c28" value="Downstream" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=9;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1755" y="80" width="230" height="18" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="SSE end · GET /uploads/{id}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="&lt;b&gt;What the two cases share and where they differ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Same: ingestion (CU pages metered), validation on every document, lineage row per value, audit on every write, outbox → Service Bus → PUT with idempotency key, Event Grid notification, payload fetched by revision, chat index.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Differs: A spends 1–5 learn calls once per carrier format and opens a confirm-format review; B spends 0 model calls and no human. Learned $0.051 and 40 s p50 vs replay $0.0087 and 0.3 s p50 (results 2026-10-24-learn-loop-quality).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;After case A's approval, every later document of that carrier is case B.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#C9D1DA;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1900" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5-End-to-end---known-carrier-format" name="5 End to end - known carrier format"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1600" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="5 · End to end, case B: a carrier format already active — fingerprint hit → replay with zero model calls → published → quote system" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#15233B;fontSize=16;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2000" height="28" as="geometry"/></mxCell><mxCell id="c4" value="No human involvement unless a routing rule sends the document to review (hard failure, 0 rows, totals printed but none read, ambiguous composite, carrier mismatch). The quote payload at revision 1 already carries the claims and both feature snapshots." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="2000" height="36" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Upload screen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;POST /uploads (files, quoteId, carrierHint, valuationDate)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Idempotency-Key ui-&lt;uuid&gt; · then SSE /events&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="230" height="84" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;CreateUpload → 202&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;uploadId up-… · Blob uploads/{id}/{file}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;dbo.Upload received · AuditEvent upload.create&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;start IngestUploadOrchestrator (instance = uploadId)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="285" y="206" width="230" height="84" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ExpandUpload → ParseFile ×N → RecordItems&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;→ ProcessLossRun ×M → CompleteUpload&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;SSE progress: expand · parse · fingerprint · route · replay|learn · validate · done&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="530" y="312" width="230" height="84" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Ingestion (CU, metered)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;layout (single run) or classifier (bundle split) → graph.json&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;header repair · stacked headers · evidence detector · header-block fields&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;LOB ≠ WC / analysis / changes-only → kept, not processed · UsageEvent per page&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="775" y="418" width="230" height="84" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Fingerprint HIT (deterministic, free)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;identityKey == and headerKey == on a non-retired version&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;0 embeddings · carrierHint disambiguates CSVs sharing a header tuple&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;(drift → replay prior; unmapped&gt;0 &amp; soft≤3 → Delta, 1 small call)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="524" width="230" height="84" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Replay (0 model calls)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;tables qualify ≥0.8 header match · normalizers · derived sums&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;lineage per value: page+polygon | sheet+cell, formatId@v, confidence&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;catalog R-01…R-32 · hard=0, unmapped=0, soft≤3 → ReplayAccepted&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;measured: p50 0.3 s, p95 4.0 s, mean $0.0087/document (PDF $0.0063, spreadsheet $0)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="630" width="230" height="96" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Format memory side effects&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;field success stats ++ · embedding hit recorded&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;alias evidence RecordVerified (3 docs / 2 formats → active)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;shadow format: clean replay count (3 → active)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="748" width="230" height="84" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ValidateAndPersist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;catalog re-run on replay.json · finalTier ReplayAccepted · reviewKind none&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;SQL txn: Document (ReviewState null), PolicyPeriod, Claim, ExtractedValue,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;RuleOutcome, DocumentCost, AuditEvent extraction.persist · manifest processed&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1E5AA8;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1510" y="854" width="230" height="96" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;CompleteUpload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;awaiting = 0 → status completed · BumpQuoteRevision → 1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Outbox upload.completed, quote.revised, quote.payload (readiness, changedDocuments,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;quotePayloadUrl ?revision=1) in ONE transaction with the audit row&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="530" y="972" width="230" height="96" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;OutboxRelay → Service Bus / Event Grid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;fast path + 30 s sweep · MessageId = event id = Idempotency-Key = outbox id&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;session = quoteId · duplicate detection 1 day · DLQ after 10&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#5B4BB5;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1755" y="1090" width="230" height="84" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;QuoteCommandDispatch → PUT quotes/{q}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Idempotency-Key header · 2xx delivered · 409 stale-revision → superseded&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;other 4xx → DLQ · 5xx → redeliver&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#5B4BB5;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1755" y="1196" width="230" height="84" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Quote system (mock)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;stores lossRunAnalysis by highest revision · fetches&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;GET /quotes/{q}/quote-payload?revision=n (ETag q-n, 304, 409 superseded)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Event Grid lossrun.quote.revised also triggers the fetch · page SSE 'revision'&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#5B4BB5;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1755" y="1302" width="230" height="96" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Loss Information page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;one column per policy period · approved values fill · unresolved 'needs input'&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;rejected document → 'excluded' · premium/payroll/ex-mod blank (not from loss run)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;live check: revision 2 visible 1 s after the decision&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1755" y="1420" width="230" height="84" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Chat index (AI Search lossrun-docs)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;one chunk per page/sheet, original page text only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;embeddings metered to the upload · never overwritten by corrections&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1755" y="1526" width="230" height="84" as="geometry"/></mxCell><mxCell id="c19" value="Browser / UI" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=9;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="230" height="18" as="geometry"/></mxCell><mxCell id="c20" value="HTTP API" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#C9D1DA;strokeWidth=1;fontColor=#15233B;fontSize=9;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="285" y="80" width="230" height="18" as="geometry"/></mxCell><mxCell id="c21" value="Orchestration" style="rounded=0;arcSi