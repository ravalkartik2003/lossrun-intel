<mxfile host="app.diagrams.net"><diagram id="1-Format-memory-and-glossary" name="1 Format memory and glossary"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1600" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="1 · How a carrier format and the glossary come into existence when a file is uploaded" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#15233B;fontSize=16;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2000" height="28" as="geometry"/></mxCell><mxCell id="c4" value="Code-verified: FormatRouter.cs · Fingerprint.cs · FormatLearner.cs · SpecVerifier.cs · SpecLint.cs · GlossaryAliases.cs · ReferenceData.cs. Thresholds are the values in code/config today." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="2000" height="36" as="geometry"/></mxCell><mxCell id="c5" value="Deterministic step (code, no model)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="90" width="230" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Model call (metered)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="120" width="230" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Decision" style="rhombus;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="150" width="230" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Store (SQL · Blob · index)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1E5AA8;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="180" width="230" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Human step" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE9D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="210" width="230" height="24" as="geometry"/></mxCell><mxCell id="c10" value="Published / straight-through" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1760" y="240" width="230" height="24" as="geometry"/></mxCell><mxCell id="c11" value="External system" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#5B4BB5;strokeWidth=1.2;fontColor=#15233B;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1760" y="270" width="230" height="24" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Upload accepted&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;POST /api/v1/uploads · uploadId = up-sha256(key)[..20]&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="240" height="54" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Ingestion (per file)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;sniff · unlock · text layer / scan dpi&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;Content Understanding: layout or classifier (bundle split)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;→ graph.json (pages, words, tables, polygons)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="240" height="84" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Header resolution — no model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;1 exact alias (NormalizeText) → 2 component-sum (A + B) →&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;3 component+measure → 4 conditional word → 5 measure-only ×0.8&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;seed glossary.json 0.4.3 + ACTIVE learned aliases only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;header repair: form-row drop, merged-cell split; stacked 'A over B'&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="240" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Conditional alias?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;'Loss' → indemnity only if a sibling&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;column resolves to claim.medical.*&lt;/font&gt;" style="rhombus;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="240" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;ambiguous-composite&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;header left unresolved; review unless&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;printed totals tie (R-10/R-12 pass)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="240" height="64" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Scope gates before any learn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;line of business ≠ WC → kept, not processed (ADR 0020)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;loss-analysis / changes-only pages → kept (ADR 0021)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;narrative PDF (0 tables) → review, never learned (ADR 0009)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="240" height="84" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="no sibling" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="340"/><mxPoint x="300" y="672"/></Array></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Fingerprint (free)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;identityKey = sha256(page-1 title/pageHeader, digits stripped)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;headerKey = sha256(first table header cells)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;ShortKey fp:&lt;12&gt;:&lt;12&gt; = escalation dedupe key&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="260" height="84" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Exact match?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;identityKey == &amp;&amp; headerKey ==,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;not retired; prefer carrierHint ≥0.8&lt;/font&gt;" style="rhombus;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="340" y="210" width="260" height="90" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Identity match only?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;= drift: header tuple changed&lt;/font&gt;" style="rhombus;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="260" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Embedding tier (PDF only, 1 embedding)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;text-embedding-3-large on 2,000 chars of page 1 (digits→0)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;cosine ≥ min(adaptive max(0.90, mean−2σ), spec 0.95)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;AND identity-token containment ≥ 0.8&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B42318;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="260" height="84" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Score ≥ threshold&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;and containment ≥ 0.8?&lt;/font&gt;" style="rhombus;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="340" y="550" width="260" height="80" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Recovery replay (free)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;replay every non-retired same-kind format with carrier&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;hint match or containment ≥ 0.5; rank 3: 0 hard &amp; 0 unmapped,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;2: 0 hard, 1: OCR-only failures; rows&gt;0 required&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="340" y="660" width="260" height="84" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Any usable candidate?&lt;/b&gt;" style="rhombus;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="340" y="770" width="260" height="70" as="geometry"/></mxCell><mxCell id="c30" value="in scope" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="647"/><mxPoint x="310" y="142"/></Array></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="no (miss)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C4858;strokeWidth=1.3;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#3C4858;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;Replay (0 model calls, deterministic)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;tables qualify at headerMatchMin 0.8 · normalizers · derived sums&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;scan OCR-tolerant headers (similarity ≥ 0.8) · every value gets&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;lineage: page+polygon or sheet+cell, formatId@version, confidence&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;rule catalog R-01…R-32 evaluated&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15233B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="300" height="96" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;FormatRouter.Decide — in order&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;1 carrier mismatch → Review · 2 no format &amp; narrative → Review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;3 no format → Learn · 4 drift, unmapped&gt;0, soft≤3 → Delta&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;5 drift → Learn · 7 no replay → Review · 8 0 rows &amp; no 'no losses' → Review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;9 hard&gt;0 all OCR-level → Review+pre-fill · 10/11 hard=0,unmapped=0,soft≤3 → Accept&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;12 unmapped&gt;0, soft≤3 → Delta · 13 else Review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;then: accepted but totals printed &amp; none read → Review; ambiguous composite → Review; Learn &amp; scan&lt;280 dpi → Review&lt;/font&gt;" style="rhombus;rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B4620B;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="660" y="230" width="300" height="150" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;ReplayAccepted → published&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;field success stats ++ · embedding hit recorded&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;alias evidence: RecordVerified(tie = R-10/R-12 non-fail)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;shadow format: cleanReplays++ (3 → active)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#15233B;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="660" y="410" width="300" height="84" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Delta repair (1 small-model call)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;gpt-5.4-mini · schema column_map_delta · only unmapped headers&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;verify → publish v(n+1), inherits prior status&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#3C4858&quot;&gt;not clean → one full Learn with prior · scan&lt;280 dpi 