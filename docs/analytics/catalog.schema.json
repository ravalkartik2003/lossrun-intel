{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lossrun-poc/analytics/catalog.schema.json",
  "title": "Analytics catalog (brief 10)",
  "description": "Validates docs/analytics/catalog.yaml (converted to JSON). MetricFlow-style metric specs extended with insurance fields (underwriter-analytics.md KQ9).",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "owner", "conventions", "scenario", "metrics"],
  "properties": {
    "catalogVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "owner": { "type": "string" },
    "approvers": { "type": "array", "items": { "type": "string" } },
    "conventions": { "type": "object", "additionalProperties": { "type": "string" } },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "order", "parameters"],
      "properties": {
        "description": { "type": "string" },
        "order": { "type": "array", "items": { "type": "string" } },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "description"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "default": {},
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "description", "type", "unit", "fromSummary", "expr", "nulls", "inputs", "valuation", "tolerance", "owner"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "type": { "enum": ["simple", "ratio", "derived", "cumulative"] },
          "unit": { "enum": ["count", "money", "ratio", "rate", "days"] },
          "fromSummary": { "enum": ["yes", "no"], "description": "ADR 0017: computable from the period rows of a summary-only loss run (LossRun.Analytics.PeriodSummaries)." },
          "expr": { "type": "string" },
          "agg": { "enum": ["count", "sum", "median", "percentile", "average"] },
          "numerator": { "type": "string" },
          "denominator": { "type": "string" },
          "breakdown": { "enum": ["component", "policyYear", "threshold", "cause", "bodyPart", "nature", "ageBucket", "jurisdiction"] },
          "filters": { "type": "array", "items": { "type": "string" } },
          "params": { "type": "object" },
          "nulls": { "type": "string" },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "transformation"],
              "properties": {
                "field": { "type": "string", "pattern": "^(claim|period|document|context)\\.[A-Za-z.]+$" },
                "transformation": {
                  "description": "OpenLineage column-lineage transformation (DIRECT: IDENTITY | TRANSFORMATION | AGGREGATION; INDIRECT_*: JOIN | GROUP_BY | FILTER | SORT | WINDOW | CONDITIONAL).",
                  "enum": ["IDENTITY", "TRANSFORMATION", "AGGREGATION", "INDIRECT_JOIN", "INDIRECT_GROUP_BY", "INDIRECT_FILTER", "INDIRECT_SORT", "INDIRECT_WINDOW", "INDIRECT_CONDITIONAL"]
                }
              }
            }
          },
          "valuation": { "type": "string" },
          "tolerance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["exact", "money", "relative", "absolute"] },
              "value": { "type": "number", "minimum": 0 },
              "absolute": { "type": "number", "minimum": 0 },
              "relative": { "type": "number", "minimum": 0 }
            }
          },
          "owner": { "type": "string" },
          "caNote": { "type": "string" }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "ratio" } } }, "then": { "required": ["numerator", "denominator"] } },
          { "if": { "properties": { "tolerance": { "properties": { "kind": { "const": "money" } } } } }, "then": { "properties": { "tolerance": { "required": ["absolute", "relative"] } } } },
          { "if": { "properties": { "tolerance": { "properties": { "kind": { "enum": ["relative", "absolute"] } } } } }, "then": { "properties": { "tolerance": { "required": ["value"] } } } }
        ]
      }
    }
  }
}
